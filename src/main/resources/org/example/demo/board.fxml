<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import java.net.URL?>
<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.demo.Controller" spacing="10" styleClass="farm-root">
  <stylesheets>
    <URL value="@styles.css" />
  </stylesheets>

  <!-- Top status bar: coins + player name -->
  <HBox spacing="10" alignment="CENTER_LEFT">
    <Label fx:id="coinsLabel" text="Coins: 0" styleClass="coins-label" />
    <Label fx:id="playerLabel" text="Player: " styleClass="player-label" />
  </HBox>

  <!-- Game board grid (cells created by Controller) -->
  <GridPane fx:id="gameBoard" VBox.vgrow="ALWAYS" hgap="5" vgap="5" styleClass="game-board" />

  <!-- Action buttons -->
  <HBox spacing="10" alignment="CENTER">
    <Button fx:id="plantButton" text="Plant" onAction="#handlePlant" styleClass="plot-button action-plant" />
    <Button fx:id="harvestButton" text="Harvest" onAction="#handleHarvest" styleClass="plot-button action-harvest" />
    <Button fx:id="stealButton" text="Steal" onAction="#handleSteal" styleClass="plot-button action-steal" />
    <Button fx:id="visitButton" text="Visit" onAction="#handleVisit" styleClass="plot-button action-visit" />
    <Button fx:id="returnButton" text="Return" onAction="#handleReturn" styleClass="plot-button action-return" />
  </HBox>

  <HBox spacing="10" alignment="CENTER">
    <Button fx:id="reconnectButton" text="Reconnect" onAction="#handleReconnect" disable="true" visible="false" styleClass="plot-button action-reconnect" />
    <Button fx:id="disconnectButton" text="Disconnect" onAction="#handleDisconnect" styleClass="plot-button action-disconnect" />
  </HBox>

  <!-- Bottom notification bar -->
  <Label fx:id="statusLabel"
         text="Please login first."
         maxWidth="Infinity"
         styleClass="status-bar" />
</VBox>